default_platform(:ios)

platform :ios do
  desc "Build and upload NovaKit Prompt App to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    increment_build_number(
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.strftime("%Y%m%d%H%M")),
      xcodeproj: "NovaKitPromptApp.xcodeproj"
    )

    build_app(
      scheme: "NovaKitPromptApp",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV.fetch("BUNDLE_ID", "com.yourname.novakitpromptapp") => ENV.fetch("PROVISIONING_PROFILE_NAME", "NovaKitPromptApp AppStore")
        }
      },
      output_directory: "build",
      output_name: "NovaKitPromptApp.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/NovaKitPromptApp.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
