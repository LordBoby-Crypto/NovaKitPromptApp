default_platform(:ios)

platform :ios do
  desc "Build and upload NovaKitPromptApp to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    build_number = Time.now.strftime("%Y%m%d%H%M")

    increment_build_number(
      build_number: build_number,
      xcodeproj: "NovaKitPromptApp.xcodeproj"
    )

    build_app(
      scheme: "NovaKitPromptApp",
      project: "./NovaKitPromptApp.xcodeproj",
      export_method: "app-store",
      output_directory: "build",
      output_name: "NovaKitPromptApp",
      clean: true,
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV["APPLE_TEAM_ID"]}",
        "PRODUCT_BUNDLE_IDENTIFIER=#{ENV["BUNDLE_ID"]}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=Apple\\ Distribution",
        "PROVISIONING_PROFILE_SPECIFIER=#{ENV["PROVISIONING_PROFILE_NAME"]}"
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => ENV["PROVISIONING_PROFILE_NAME"]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
