require "shellwords"

opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and upload NovaKitPromptApp to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    build_number = ENV.fetch("BUILD_NUMBER", Time.now.utc.strftime("%Y%m%d%H%M%S"))
    marketing_version = ENV.fetch("MARKETING_VERSION", "1.0")

    update_info_plist(
      plist_path: "NovaKitPromptApp/Info.plist",
      block: proc do |plist|
        plist["CFBundleVersion"] = build_number
        plist["CFBundleShortVersionString"] = marketing_version
      end
    )

    UI.message("Using CFBundleShortVersionString=#{marketing_version} and CFBundleVersion=#{build_number}")

    apple_team_id = ENV["APPLE_TEAM_ID"]
    bundle_id = ENV["BUNDLE_ID"]
    profile_name = ENV["PROVISIONING_PROFILE_NAME"]

    xcargs = [
      "DEVELOPMENT_TEAM=#{apple_team_id.shellescape}",
      "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id.shellescape}",
      "CURRENT_PROJECT_VERSION=#{build_number.shellescape}",
      "MARKETING_VERSION=#{marketing_version.shellescape}",
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=#{'Apple Distribution'.shellescape}",
      "PROVISIONING_PROFILE_SPECIFIER=#{profile_name.shellescape}"
    ].join(" ")

    build_app(
      scheme: "NovaKitPromptApp",
      project: "./NovaKitPromptApp.xcodeproj",
      export_method: "app-store",
      output_directory: "build",
      output_name: "NovaKitPromptApp",
      clean: true,
      xcargs: xcargs,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: apple_team_id,
        provisioningProfiles: {
          bundle_id => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload App Store Connect metadata only"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    deliver(
      api_key: api_key,
      app_identifier: ENV["BUNDLE_ID"],
      metadata_path: "fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true
    )
  end

end
